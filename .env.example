# Juan Heart Mobile - Environment Variables Template
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to version control!

# ==============================================================================
# TWILIO SMS CONFIGURATION
# ==============================================================================
# Get these credentials from: https://console.twilio.com/
# Used for: SMS notifications and OTP verification
ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_NUMBER=+1XXXXXXXXXX

# ==============================================================================
# ML ASSESSMENT SERVICE
# ==============================================================================
# Firebase Cloud Function endpoint for ML-powered heart risk assessment
# Production URL (HTTP wrapper with public access)
GENKIT_BACKEND_URL=https://us-central1-juan-heart-project.cloudfunctions.net/assessHeartRiskHttp

# ==============================================================================
# FEATURE FLAGS (OPTIONAL)
# ==============================================================================
# Remote configuration URL for dynamic feature flags
# Leave empty to use local feature flags only
# Production: Set to your Firebase Remote Config or custom backend URL
FEATURE_FLAGS_URL=

# ==============================================================================
# EDUCATIONAL CONTENT BACKEND API
# ==============================================================================
# Backend server for educational content (articles, videos, health tips)
# Development: http://localhost:8000/api/v1/mobile OR http://YOUR_LOCAL_IP:8000/api/v1/mobile
# Production: https://your-production-api.com/api/v1/mobile
EDUCATIONAL_CONTENT_API_URL=http://192.168.1.8:8000/api/v1/mobile

# ==============================================================================
# GOOGLE GEOCODING API
# ==============================================================================
# Get API key from: https://console.cloud.google.com/apis/credentials
# Used for: Reverse geocoding (GPS coordinates → city/region names)
# Security: Restrict this key to Geocoding API only in Google Cloud Console
GOOGLE_GEOCODING_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ==============================================================================
# ENVIRONMENT CONFIGURATION
# ==============================================================================
# Optional: Set environment (development, staging, production)
# APP_ENV=development
