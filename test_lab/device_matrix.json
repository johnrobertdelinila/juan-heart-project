  "knownDeviceIssues": {
    "samsung": {
      "issue": "Edge panel interference",
      "affectedModels": ["Galaxy S series", "Galaxy Note series"],
      "workaround": "Test swipe gestures from edge, ensure no conflicts",
      "severity": "medium"
    },
    "xiaomi": {
      "issue": "Aggressive battery optimization kills background sync",
      "affectedModels": ["All MIUI devices"],
      "workaround": "Request battery optimization exemption, document in setup",
      "severity": "high"
    },
    "huawei": {
      "issue": "HMS vs GMS services compatibility",
      "affectedModels": ["Post-2019 Huawei devices"],
      "workaround": "Ensure app works without Google Play Services",
      "severity": "critical"
    },
    "oppo": {
      "issue": "Permission prompts on every app launch",
      "affectedModels": ["ColorOS devices"],
      "workaround": "Document permission setup, test permission persistence",
      "severity": "medium"
    },
    "vivo": {
      "issue": "Notification delivery delays",
      "affectedModels": ["Funtouch OS devices"],
      "workaround": "Test notification settings, request exemptions",
      "severity": "medium"
    },
    "oneplus": {
      "issue": "Gesture navigation conflicts",
      "affectedModels": ["OxygenOS devices"],
      "workaround": "Test all gestures, provide alternative navigation",
      "severity": "low"
    },
    "ios": {
      "issue": "Safe area insets with notch/Dynamic Island",
      "affectedModels": ["iPhone X and later"],
